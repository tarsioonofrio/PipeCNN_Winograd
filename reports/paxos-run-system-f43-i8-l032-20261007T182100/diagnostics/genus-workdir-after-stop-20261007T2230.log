        lappend HDL_FILES [file normalize $entry]
    } else {
        set candidate [file normalize [file join $GIT_ROOT $entry]]
        if {![file exists $candidate]} { error "Missing HDL source: $candidate" }
        lappend HDL_FILES $candidate
    }
}
